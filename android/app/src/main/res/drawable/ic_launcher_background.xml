<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the "Aurora Lab" void surface with the same four
     bloom gradients used by @drawable/bg_aurora, so the launcher tile reads as
     a miniature of the app itself. Edge-to-edge on purpose — the launcher
     applies its own mask and parallax on top. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Void base -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#FF0A0E20" />
                <item android:offset="0.55" android:color="#FF070A16" />
                <item android:offset="1.0" android:color="#FF0D0B22" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- indigo bloom, top-left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="16" android:centerY="6"
                android:gradientRadius="72">
                <item android:offset="0.0" android:color="#8C6366F1" />
                <item android:offset="0.6" android:color="#3D6366F1" />
                <item android:offset="1.0" android:color="#006366F1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- cyan bloom, top-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="100" android:centerY="18"
                android:gradientRadius="60">
                <item android:offset="0.0" android:color="#7522D3EE" />
                <item android:offset="0.6" android:color="#2E22D3EE" />
                <item android:offset="1.0" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- violet bloom, lower-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="96" android:centerY="100"
                android:gradientRadius="66">
                <item android:offset="0.0" android:color="#66A78BFA" />
                <item android:offset="0.6" android:color="#26A78BFA" />
                <item android:offset="1.0" android:color="#00A78BFA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- faint warm accent, bottom-left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="8" android:centerY="104"
                android:gradientRadius="52">
                <item android:offset="0.0" android:color="#3DFB923C" />
                <item android:offset="1.0" android:color="#00FB923C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
