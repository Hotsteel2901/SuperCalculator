<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a pair of coordinate axes carrying a plotted
     curve that rises to a pole, breaks, and resumes on the far side — the
     signature behaviour of the calculator's graph engine.

     Safety: the outer 18dp of the 108dp canvas is the adaptive-icon safe
     zone border, so nothing outside the centre 72dp square is guaranteed to
     survive masking. The emblem lives inside the centre 66dp circle so the
     round mask cannot clip it.

     Note: android:strokeWidth may NOT be supplied through <aapt:attr> — AAPT2
     rejects it ("Cannot find attribute strokeWidth"). The tapered branch look
     is therefore built from two overlapping strokes of different widths. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground glow: a soft plinth that lifts the emblem off the aurora -->
    <path android:pathData="M54,86m-30,0a30,30 0 1,0 60,0a30,30 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="86"
                android:gradientRadius="30">
                <item android:offset="0.0" android:color="#4D22D3EE" />
                <item android:offset="1.0" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Coordinate axes -->
    <path
        android:pathData="M26,86H84"
        android:strokeColor="#8FA7B0D6"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M26,86V24"
        android:strokeColor="#8FA7B0D6"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />

    <!-- Axis ticks -->
    <path android:pathData="M26,44h3M26,62h3M26,74h3M42,86v-3M58,86v-3M70,86v-3"
        android:strokeColor="#59A7B0D6"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />

    <!-- Branch 1: shoots up towards the pole.
         Built as a wide base stroke plus a narrower highlight stroke that
         stops short of the tip, which reads as a taper without needing a
         gradient strokeWidth (unsupported by AAPT2). -->
    <path
        android:pathData="M31,79C41,76 50.5,62 55.5,45L60.5,30"
        android:strokeColor="#FF34D399"
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M42.5,74.5C49.5,68 54,57 56.5,45L58.4,36"
        android:strokeColor="#FF6EE7B7"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Branch 2: re-enters just past the pole and settles towards the axis -->
    <path
        android:pathData="M72,86C69.5,73 68,62 76,57"
        android:strokeColor="#FF22D3EE"
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M71,81C69.2,72.5 68.4,63.5 74.6,58.6"
        android:strokeColor="#FF7DE8FA"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The break itself: a dashed asymptote where the curve refuses to connect.
         Drawn as explicit segments (not strokeDashArray) so the pattern renders
         identically on every API level. -->
    <path
        android:pathData="M65,31V40M65,46V55M65,61V70M65,76V86"
        android:strokeColor="#B3A78BFA"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Pole marker -->
    <path android:pathData="M65,27.6m-2.9,0a2.9,2.9 0 1,0 5.8,0a2.9,2.9 0 1,0 -5.8,0"
        android:fillColor="#FFA78BFA" />

    <!-- Positive-x emphasis, right where the pole sits -->
    <path android:pathData="M65,86m-2.4,0a2.4,2.4 0 1,0 4.8,0a2.4,2.4 0 1,0 -4.8,0"
        android:fillColor="#BFA7B0D6" />

    <!-- Origin dot -->
    <path android:pathData="M26,86m-3.1,0a3.1,3.1 0 1,0 6.2,0a3.1,3.1 0 1,0 -6.2,0"
        android:strokeColor="#FFE6EAFF"
        android:strokeWidth="2.4" />
</vector>
