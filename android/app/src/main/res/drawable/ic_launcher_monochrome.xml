<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome adaptive-icon layer (Android 13+ themed icons). The launcher
     recolours this to fit the user's wallpaper palette, so it must be pure
     white with alpha — colour and gradients are discarded. Shape only.

     Same geometry as ic_launcher_foreground, drawn with a uniform stroke
     width because a themed icon has no room for the gradient taper. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Coordinate axes -->
    <path
        android:pathData="M26,86H84"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M26,86V24"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round" />

    <!-- Axis ticks -->
    <path android:pathData="M26,44h3M26,62h3M26,74h3M42,86v-3M58,86v-3M70,86v-3"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />

    <!-- Curve branch rising into the pole -->
    <path
        android:pathData="M31,79C41,76 50.5,62 55.5,45L60.5,30"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Curve branch resuming past the pole -->
    <path
        android:pathData="M72,86C69.5,73 68,62 76,57"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Pole marker -->
    <path android:pathData="M65,27.6m-2.9,0a2.9,2.9 0 1,0 5.8,0a2.9,2.9 0 1,0 -5.8,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Origin dot -->
    <path android:pathData="M26,86m-3.1,0a3.1,3.1 0 1,0 6.2,0a3.1,3.1 0 1,0 -6.2,0"
        android:fillColor="#FFFFFFFF" />
</vector>
