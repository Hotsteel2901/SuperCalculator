<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sc_void">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="Function Plot"
            app:titleTextColor="@color/m3_on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SuperCalc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="@string/plot_controls"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.SuperCalc.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_fx"
                        app:hintTextColor="@color/m3_outline"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/plot_expr_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/m3_on_surface"
                            android:textSize="16sp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:singleLine="true"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_curve"
                            style="@style/Widget.SuperCalc.GlassButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="@string/add_curve"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_remove_curve"
                            style="@style/Widget.SuperCalc.GlassButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="@string/remove_curve"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_find_intersections"
                            style="@style/Widget.SuperCalc.GlassButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="@string/intersect"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <!-- 已添加曲线（动态列出，位于三个按钮下方） -->
                    <LinearLayout
                        android:id="@+id/curve_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/curve_list_title"
                            android:textSize="11sp"
                            android:textColor="@color/m3_on_surface_variant"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/curve_list_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@color/result_bg"
                            android:padding="10dp"
                            android:textSize="12sp"
                            android:textColor="@color/m3_on_surface"
                            android:fontFamily="@font/jetbrains_mono"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                    <!-- 动态参数（自动识别） -->
                    <TextView
                        android:id="@+id/param_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/param_hint"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.06"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />
                    <HorizontalScrollView
                        android:id="@+id/param_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none"
                        android:visibility="gone">
                        <LinearLayout
                            android:id="@+id/param_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SuperCalc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="@string/coordinate_range"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_x_min"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            app:hintTextColor="@color/m3_outline"
                            android:layout_marginEnd="4dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/x_min_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="-10"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textSize="14sp"
                                android:textColor="@color/m3_on_surface"
                                android:singleLine="true"
                                android:inputType="numberDecimal|numberSigned" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_x_max"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            app:hintTextColor="@color/m3_outline"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/x_max_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textSize="14sp"
                                android:textColor="@color/m3_on_surface"
                                android:singleLine="true"
                                android:inputType="numberDecimal|numberSigned" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_y_min"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            app:hintTextColor="@color/m3_outline"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/y_min_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="-10"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textSize="14sp"
                                android:textColor="@color/m3_on_surface"
                                android:singleLine="true"
                                android:inputType="numberDecimal|numberSigned" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_y_max"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            app:hintTextColor="@color/m3_outline"
                            android:layout_marginStart="4dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/y_max_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textSize="14sp"
                                android:textColor="@color/m3_on_surface"
                                android:singleLine="true"
                                android:inputType="numberDecimal|numberSigned" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_plot_all"
                        style="@style/Widget.SuperCalc.GlassButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/plot_all_curves"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SuperCalc.Card"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:text="@string/plot_title"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_zoom"
                            style="@style/Widget.SuperCalc.GlassButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="@string/full_screen"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="12sp"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/full_line_chart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 交点坐标（页面最底部） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/intersect_card"
                style="@style/Widget.SuperCalc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/intersect_result_title"
                        android:textSize="12sp"
                        android:textColor="@color/spectral_integrate"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/intersect_result_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@color/result_bg"
                        android:padding="10dp"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface"
                        android:fontFamily="@font/jetbrains_mono"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.SuperCalc.GlassButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/back_to_calc"
                android:fontFamily="@font/jetbrains_mono"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
