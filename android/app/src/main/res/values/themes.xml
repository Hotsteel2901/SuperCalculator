<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base M3 dark theme — "Aurora Lab" -->
    <style name="Theme.SuperCalc" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary from the cyan-blue spectral range -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>

        <!-- Typography -->
        <item name="fontFamily">@font/outfit_regular</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/sc_void</item>
        <item name="android:navigationBarColor">@color/sc_void</item>
        <item name="android:windowBackground">@color/sc_void</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Card style — frosted glass surface with a hairline light edge.
         Matches the floating LiquidGlass bars without paying for a real
         refraction pass on every one of the 34 cards. -->
    <style name="Widget.SuperCalc.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Sticky app header -->
    <style name="Widget.SuperCalc.Header" parent="">
        <item name="android:background">@color/void_surface</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Outlined text field — expression input -->
    <style name="Widget.SuperCalc.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/glass_field_stroke</item>
        <item name="boxBackgroundColor">@color/glass_field_fill</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- In-card action button — same frosted material language as the floating
         glass bars: translucent fill, hairline light edge, no elevation.
         The per-operation colour lives on the label instead of a hard outline. -->
    <style name="Widget.SuperCalc.GlassButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/glass_button_tint</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="iconTint">@color/m3_on_surface</item>
    </style>

    <!-- Quick-select chip — frosted pill -->
    <style name="Widget.SuperCalc.GlassChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/glass_chip_tint</item>
        <item name="chipStrokeColor">@color/glass_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
</resources>
